        "StoreWalk": {
          "$path": "src/assets/StoreWalk.rbxm"
        },
        "StoreBed": {
          "$path": "src/assets/StoreBed.rbxmx"
        },
        "StoreDoor": {
          "$path": "src/assets/StoreDoor.rbxmx"
        },
        "Posto17R6Corpo": {
          "$path": "src/assets/Posto17R6Corpo.rbxmx"
        },
        "Posto17R6Amostras": {
          "$path": "src/assets/Posto17R6Amostras.rbxmx"
        },
        "Posto17R6Preview": {
          "$path": "src/assets/Posto17R6Preview.rbxmx"
        },
        "Posto17R6Interacoes": {
          "$path": "src/assets/Posto17R6Interacoes.rbxmx"
        }
      }
    },
    "ServerStorage": {
      "Posto17RobloxWeapons": {
        "$path": "src/assets/Posto17RobloxWeapons.rbxmx"
      }
    },
    "AssetService": {
